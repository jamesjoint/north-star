ANTHROPIC_API_KEY=your_anthropic_api_key_here
COMPOSIO_API_KEY=your_composio_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
# LinkedIn Composio action name — check your Composio dashboard for the exact name
LINKEDIN_ACTION=LINKEDIN_SEARCH_JOB_POSTINGS
PORT=3001
SCRAPE_CRON=0 8 * * *

# PostgreSQL — Railway injects DATABASE_URL automatically in production
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL_TEST=postgresql://user:password@host:5432/dbname_test

# better-auth — generate a random 32+ char secret
BETTER_AUTH_SECRET=change_me_to_a_random_secret_at_least_32_chars
BETTER_AUTH_URL=https://your-app.railway.app

# Resend (https://resend.com) — for magic link and notification emails
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=noreply@yourdomain.com

# Your email address — set before running the migration script
ADMIN_EMAIL=you@example.com

# Migration only — path to the old SQLite database
SQLITE_DB_PATH=./jobs.db
